{
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "editor.formatOnSave": true,
  "git.confirmSync": false,
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "gopls": {
    "ui.diagnostic.staticcheck": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "workbench.colorCustomizations": {
    // エディタインデントガイド: グラデでクールレインボー
    // サイバーパンク系・ネオン強めでコントラスト高く、インデントが視認しやすいカッコいいグラデーション
    "editorIndentGuide.background1": "#00fff7", // ネオンアクア
    "editorIndentGuide.background2": "#21eeff", // エレクトリックシアン
    "editorIndentGuide.background3": "#208eff", // ネオンサックス
    "editorIndentGuide.background4": "#a259ff", // ネオンバイオレット
    "editorIndentGuide.background5": "#f81ce6", // ネオンピンク
    "editorIndentGuide.background6": "#ffe066", // ネオンイエロー
    "editorIndentGuide.activeBackground1": "#00ffc3", // アクティブ時・明るいアクア
    "editorIndentGuide.activeBackground2": "#3ee9fa", // アクティブ時・ライトシアン
    "editorIndentGuide.activeBackground3": "#5e7fff", // アクティブ時・ブルー寄り
    "editorIndentGuide.activeBackground4": "#bc6fff", // アクティブ時・パープル
    "editorIndentGuide.activeBackground5": "#ff5c8a", // アクティブ時・ビビッドピンク
    "editorIndentGuide.activeBackground6": "#faf594" // アクティブ時・ライトイエロー
  },
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'Hiragino Sans', monospace",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.lineHeight": 1,
  "workbench.startupEditor": "none",
  "diffEditor.ignoreTrimWhitespace": false,
  "search.showLineNumbers": true,
  "zenMode.hideLineNumbers": false,
  "workbench.settings.applyToAllProfiles": [
    "notebook.lineNumbers",
    "editor.inlineSuggest.enabled"
  ],
  "explorer.confirmDelete": false,
  "go.toolsManagement.autoUpdate": true,
  "database-client.autoSync": true,
  "makefile.configureOnOpen": false,
  "githubPullRequests.createOnPublishBranch": "never",
  "extensions.ignoreRecommendations": true,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.inlineSuggest.edits.allowCodeShifting": "never",
  "editor.inlineSuggest.edits.renderSideBySide": "never",
  "accessibility.verbosity.inlineCompletions": false,
  "cursorpyright.analysis.autoImportCompletions": true,

  "editor.inlineSuggest.enabled": false,
  "workbench.editor.enablePreview": false,
  "editor.quickSuggestions": {
    "other": false,
    "comments": false,
    "strings": false
  },
  "editor.suggestOnTriggerCharacters": false,
  "files.autoGuessEncoding": true,
  "diffEditor.renderSideBySide": false,
  "workbench.editor.autoLockGroups": {
    "mainThreadWebview-markdown.preview": true
  },
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-light",
  "workbench.secondarySideBar.showLabels": false,
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "application.experimental.extensionMonitor.enabled": true,
  "explorer.confirmDragAndDrop": false,
  "workbench.editorAssociations": {},
  "explorer.confirmPasteNative": false,
  "window.confirmSaveUntitledWorkspace": false,
  "lldb.launch.expressions": "native",
  "cursor.agent_layout_browser_beta_setting": true,
  "editor.minimap.maxColumn": 300,
  "editor.minimap.sectionHeaderFontSize": 10,
  "editor.minimap.enabled": true,
  "lldb.suppressUpdateNotifications": true,
  "rust-analyzer.completion.fullFunctionSignatures.enable": true,
  "editor.minimap.size": "fill",
  "cursor.composer.usageSummaryDisplay": "always",
  "editor.lineNumbers": "relative",
  "notebook.lineNumbers": "on",
  "git.ignoreRebaseWarning": true,
  "editor.suggest.showStatusBar": true,
  "claudeCode.selectedModel": "default",
  "claudeCode.preferredLocation": "panel",
  "window.autoDetectColorScheme": false,
  "vscode-neovim.NVIM_APPNAME": "nvim-vscode",
  "vscode-neovim.neovimExecutablePaths.darwin": "/etc/profiles/per-user/KokiAoyagi/bin/nvim",
  "workbench.activityBar.orientation": "vertical"
}
