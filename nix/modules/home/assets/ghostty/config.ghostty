# WezTerm に寄せた Ghostty の初期設定。
# Ghostty で再現できない挙動は無理に入れず、まずは pane/tab/font 周りを揃える。

font-family = "JetBrainsMono Nerd Font"
font-family = "Hiragino Sans"
font-size = 12

background = "#000000"
foreground = "#FFFFFF"
background-opacity = 0.9
background-opacity-cells = true
background-blur = false
cursor-style = block
cursor-color = "#7DCFFF"
cursor-text = "#0B1020"

scrollback-limit = 50000000
copy-on-select = false
mouse-reporting = true

window-padding-x = 6
window-padding-y = 9,0
window-padding-balance = false
window-padding-color = background

unfocused-split-opacity = 1
split-divider-color = "#5c6d74"
split-preserve-zoom = navigation

shell-integration = detect
shell-integration-features = no-cursor
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

window-decoration = none
window-new-tab-position = end
window-show-tab-bar = never
macos-titlebar-style = hidden
macos-window-buttons = hidden
gtk-titlebar-style = tabs
gtk-toolbar-style = flat

keybind = performable:super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+p=toggle_command_palette
keybind = ctrl+@=text:\x1b

keybind = super+t=new_tab
keybind = super+w=close_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=last_tab

keybind = super+==increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+0=reset_font_size

keybind = alt+enter=toggle_fullscreen
keybind = super+shift+o=toggle_window_float_on_top
keybind = ctrl+shift+r=reload_config

keybind = ctrl+q>n=new_window
keybind = ctrl+q>w=toggle_tab_overview
keybind = ctrl+q>b=move_tab:-1
keybind = ctrl+q>f=move_tab:1

keybind = ctrl+q>shift+h=new_split:left
keybind = ctrl+q>shift+j=new_split:down
keybind = ctrl+q>shift+k=new_split:up
keybind = ctrl+q>shift+l=new_split:right
keybind = ctrl+q>h=goto_split:left
keybind = ctrl+q>j=goto_split:down
keybind = ctrl+q>k=goto_split:up
keybind = ctrl+q>l=goto_split:right
keybind = ctrl+q>x=close_surface
keybind = ctrl+q>z=toggle_split_zoom
keybind = ctrl+q>shift+b=toggle_background_opacity
keybind = ctrl+q>m=toggle_mouse_reporting
keybind = ctrl+q>s=activate_key_table:resize

keybind = resize/
keybind = resize/h=resize_split:left,10
keybind = resize/j=resize_split:down,10
keybind = resize/k=resize_split:up,10
keybind = resize/l=resize_split:right,10
keybind = resize/enter=deactivate_key_table
keybind = resize/escape=deactivate_key_table
keybind = resize/q=deactivate_key_table
